<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Sage.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- Grpc.Tools remains a build-only dependency.  WinUI's XAML targets can
         bypass the package's BeforeCompile hook, so protocol generation is
         invoked explicitly below before CoreCompile. -->
    <GrpcToolsVersion>2.83.0</GrpcToolsVersion>
    <SageProtocolSource>$(MSBuildProjectDirectory)\..\..\..\proto\sage\ipc\v1\sage.proto</SageProtocolSource>
    <SageProtocolRoot>$(MSBuildProjectDirectory)\..\..\..\proto</SageProtocolRoot>
    <SageProtocolOutputDir>$(IntermediateOutputPath)GeneratedProtocol</SageProtocolOutputDir>
    <SageProtocPath>$(NuGetPackageRoot)grpc.tools\$(GrpcToolsVersion)\tools\windows_x64\protoc.exe</SageProtocPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="Google.Protobuf" Version="3.36.0" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0" PrivateAssets="All" />
    <Content Include="..\..\..\assets\icon-source-bg.png" Link="Assets\sage-logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Generate the checked-out protocol at build time.  Nothing generated by
       protoc is checked into the repository.  Calling protoc directly keeps
       this deterministic when WinUI's design-time build changes the normal
       Grpc.Tools target ordering. -->
  <Target Name="GenerateSageProtocol" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(SageProtocolSource)')"
           Text="Sage IPC schema was not found at $(SageProtocolSource)." />
    <Error Condition="!Exists('$(SageProtocPath)')"
           Text="Grpc.Tools protoc was not found at $(SageProtocPath)." />
    <MakeDir Directories="$(SageProtocolOutputDir)" />
    <Exec Command="&quot;$(SageProtocPath)&quot; --proto_path=&quot;$(SageProtocolRoot)&quot; --csharp_out=&quot;$(SageProtocolOutputDir)&quot; &quot;$(SageProtocolSource)&quot;" />
    <ItemGroup>
      <Compile Include="$(SageProtocolOutputDir)\**\*.cs" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
