<Window
    x:Class="Sage.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Sage">
    <Grid x:Name="Root" RequestedTheme="Dark" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <Style x:Key="SidebarButtonStyle" TargetType="Button">
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="9" />
            </Style>
            <Style x:Key="TimelineItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" MinWidth="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="16,24,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="22" Height="22" CornerRadius="6" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/sage-logo.png" Stretch="Uniform" />
                </Border>
                <TextBlock Grid.Column="1" Text="Sage" Margin="8,0,0,0" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>

            <Button x:Name="NewTaskButton" Grid.Row="1" Margin="10,0" Style="{StaticResource SidebarButtonStyle}" HorizontalAlignment="Stretch" Click="NewTask_Click" ToolTipService.ToolTip="Start a new chat">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                    <TextBlock Text="New chat" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Row="2" Text="Recent" Margin="18,22,18,8" FontSize="11" Opacity="0.72" />

            <ListView x:Name="TaskList" Grid.Row="3" SelectionChanged="TaskList_SelectionChanged" SelectionMode="Single" IsItemClickEnabled="False" Padding="8,0" HorizontalContentAlignment="Stretch">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="UseSystemFocusVisuals" Value="False" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="TaskRow" MinHeight="44" Padding="10,7" CornerRadius="8" Background="{Binding RowBackground}" PointerEntered="TaskRow_PointerEntered" PointerExited="TaskRow_PointerExited" Tapped="TaskRow_Tapped">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Rename" Tag="{Binding}" Click="RenameTask_Click">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Edit" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Pin / unpin" Tag="{Binding}" Click="TogglePin_Click">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Pin" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Delete" Tag="{Binding}" Click="DeleteTask_Click">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Delete" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <Grid>
                                <StackPanel Padding="0,0,4,0">
                                    <TextBlock Text="{Binding Request}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button Grid.Row="4" Margin="10,12,10,14" Style="{StaticResource SidebarButtonStyle}" HorizontalAlignment="Stretch" Click="Settings_Click" ToolTipService.ToolTip="Open settings">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                    <TextBlock Text="Settings" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TaskToolbarRow" Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="TaskToolbar" Grid.Row="0" Padding="32,16,32,10" MinHeight="60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TaskTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="UndoButton" Visibility="Collapsed" Click="Undo_Click" ToolTipService.ToolTip="Undo the last reversible action">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7A7;" FontSize="12" />
                            <TextBlock Text="Undo" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <ListView x:Name="Timeline" Padding="32,10" IsItemClickEnabled="False" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource TimelineItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MaxWidth="920" HorizontalAlignment="Center" Padding="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="7" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Top">
                                    <FontIcon Glyph="&#xE734;" FontSize="12" Opacity="0.72" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Opacity="0.7" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <Rectangle Grid.Column="1" Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Bottom" Margin="0,12,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid x:Name="EmptyState" IsHitTestVisible="False" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,64" Spacing="14">
                        <Image Source="ms-appx:///Assets/sage-logo.png" Width="46" Height="46" Stretch="Uniform" />
                        <TextBlock Text="What should we build?" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Padding="28,8,28,22">
                <Border MaxWidth="920" HorizontalAlignment="Center" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="17" Padding="14,10,14,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="Composer" Grid.Column="0" PlaceholderText="Ask to build something…" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140" MinHeight="34" Background="Transparent" BorderThickness="0" Padding="0,5,0,5" TextChanged="Composer_TextChanged" KeyDown="Composer_KeyDown" />
                            <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="Send_Click" ToolTipService.ToolTip="Send task">
                                <FontIcon Glyph="&#xE72A;" FontSize="14" />
                            </Button>
                            <Button x:Name="StopButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Visibility="Collapsed" Click="Stop_Click" ToolTipService.ToolTip="Stop task">
                                <FontIcon Glyph="&#xE71A;" FontSize="12" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
