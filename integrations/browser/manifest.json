{
  "manifest_version": 3,
  "name": "Sage Browser Companion",
  "version": "1.0.1",
  "description": "Pair one browser tab with Sage's local execution broker.",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Pair this tab with Sage" }
}
